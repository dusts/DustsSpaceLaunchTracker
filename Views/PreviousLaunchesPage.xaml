<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DustsSpaceLaunchTracker.Views.PreviousLaunchesPage"
             xmlns:vm="clr-namespace:DustsSpaceLaunchTracker.ViewModels"
             xmlns:cards="clr-namespace:DustsSpaceLaunchTracker.Views.Cards"
             x:DataType="vm:PreviousLaunchesViewModel"
             Title="Previous">

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          Padding="12"
          RowSpacing="8">

        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="{Binding StatusText}"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                   HorizontalOptions="Center"
                   IsVisible="{Binding StatusText, Converter={StaticResource IsNotNullOrEmptyConverter}}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="6">
            <SearchBar Grid.Column="0"
                       Placeholder="Search previous launches…"
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}" />
            <Button Grid.Column="1"
                    Text="Go"
                    Command="{Binding SearchCommand}"
                    Padding="12,0" />
            <Button Grid.Column="2"
                    Text="✕"
                    Command="{Binding ClearSearchCommand}"
                    Padding="12,0" />
        </Grid>

        <Picker Grid.Row="2"
                Title="Status filter"
                ItemsSource="{Binding StatusFilters}"
                ItemDisplayBinding="{Binding Name}"
                SelectedIndex="{Binding SelectedStatusIndex}" />

        <Label Grid.Row="3"
               Text="{Binding ErrorMessage}"
               TextColor="Red"
               FontSize="13"
               HorizontalTextAlignment="Center"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullOrEmptyConverter}}" />

        <RefreshView Grid.Row="4"
                     Command="{Binding LoadLaunchesCommand}"
                     IsRefreshing="{Binding IsRefreshing}">
            <CollectionView ItemsSource="{Binding Launches}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreLaunchesCommand}"
                            EmptyView="No previous launches found."
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:LaunchListItemViewModel">
                        <Grid>
                            <cards:LaunchCard />
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type CollectionView}}, Path=BindingContext.OpenLaunchCommand}"
                                    CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12" Spacing="6" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           IsVisible="{Binding IsLoadingMore}"
                                           Color="DodgerBlue"
                                           HeightRequest="32"
                                           WidthRequest="32" />
                        <Label Text="Scroll for more…"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                               IsVisible="{Binding HasMoreItems}"
                               HorizontalOptions="Center" />
                        <Label Text="End of list"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
                               IsVisible="{Binding ShowEndOfList}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Label Grid.Row="5"
               Text="Data from The Space Devs API"
               FontSize="11"
               TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}"
               HorizontalOptions="Center" />
    </Grid>
</ContentPage>
