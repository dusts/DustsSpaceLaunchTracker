<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DustsSpaceLaunchTracker.Views.LaunchDetailPage"
             xmlns:vm="clr-namespace:DustsSpaceLaunchTracker.ViewModels"
             x:DataType="vm:LaunchDetailViewModel"
             Title="Launch Detail">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="12">

                <Image Source="{Binding Launch.Image}"
                       IsVisible="{Binding HasImage}"
                       HeightRequest="200"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill" />

                <Label Text="{Binding Launch.Name}"
                       FontSize="22"
                       FontAttributes="Bold" />

                <Label Text="{Binding CountdownText}"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="DodgerBlue" />

                <Label Text="{Binding LocalNetText}" FontSize="14" />
                <Label Text="{Binding UtcNetText}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

                <Label Text="{Binding Launch.Status.Name}"
                       FontSize="15"
                       TextColor="{Binding Launch.Status, Converter={StaticResource StatusToColorConverter}}" />

                <BoxView HeightRequest="1"
                         Color="{AppThemeBinding Light=LightGray, Dark=#444}" />

                <Label Text="Rocket" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding RocketName}" />

                <Label Text="Agency" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding AgencyName}" />

                <Label Text="Pad" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding PadSummary}" />

                <Label Text="Mission" FontAttributes="Bold" FontSize="16" />
                <Label Text="{Binding MissionSummary}" LineBreakMode="WordWrap" />

                <Button Text="Open webcast"
                        Command="{Binding OpenWebcastCommand}"
                        IsVisible="{Binding HasWebcast}"
                        Margin="0,8,0,0" />

                <Button Text="Refresh"
                        Command="{Binding RefreshCommand}"
                        Margin="0,4,0,0" />

                <Border IsVisible="{Binding HasError}"
                        StrokeThickness="1"
                        Padding="10"
                        BackgroundColor="{AppThemeBinding Light=#FFF5F5, Dark=#3A1F1F}">
                    <Border.Stroke>
                        <SolidColorBrush Color="#E57373" />
                    </Border.Stroke>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="#C62828"
                               FontSize="13" />
                        <Label Text="{Binding ErrorDetail}"
                               FontSize="10"
                               IsVisible="{Binding ShowErrorDetail}"
                               LineBreakMode="WordWrap" />
                        <FlexLayout Wrap="Wrap">
                            <Button Text="Details"
                                    Command="{Binding ToggleErrorDetailCommand}"
                                    IsVisible="{Binding HasErrorDetail}"
                                    FontSize="12"
                                    Padding="10,4"
                                    Margin="0,0,8,0" />
                            <Button Text="Diagnostics"
                                    Command="{Binding OpenDiagnosticsCommand}"
                                    FontSize="12"
                                    Padding="10,4" />
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <ActivityIndicator IsRunning="{Binding IsBusy}"
                           IsVisible="{Binding IsBusy}"
                           Color="DodgerBlue"
                           HeightRequest="48"
                           WidthRequest="48"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>
