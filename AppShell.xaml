<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DustsSpaceLaunchTracker.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:DustsSpaceLaunchTracker.Views"
    Title="Dusts Space Launch Tracker"
    FlyoutBehavior="Disabled">

    <TabBar>
        <ShellContent
            Title="Upcoming"
            Route="UpcomingLaunches"
            ContentTemplate="{DataTemplate views:UpcomingLaunchesPage}" />

        <ShellContent
            Title="Previous"
            Route="PreviousLaunches"
            ContentTemplate="{DataTemplate views:PreviousLaunchesPage}" />
    </TabBar>

</Shell>
